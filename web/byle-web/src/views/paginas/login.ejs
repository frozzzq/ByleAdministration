<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { pageTitle: 'Iniciar sesión' }) %></head>
<body>
  <%- include('../partials/navbar') %>

  <div class="auth-wrapper">
    <div class="auth-box">

      <div class="auth-header">
        <img src="/img/logo.svg" alt="Byle" style="height:52px;margin:0 auto .75rem;display:block">
        <h1 class="text-h2">Bienvenido a Byle</h1>
        <p class="text-body mt-xs">Accede con tu cuenta de Google registrada como socio</p>
      </div>

      <!-- Mensaje de error -->
      <% if (locals.error === 'no_registrado') { %>
      <div class="alert-banner alert-error" style="margin-bottom:1.25rem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Tu correo no está registrado como socio. <a href="/hazte-socio" style="color:inherit;font-weight:600">Hazte socio aquí.</a></span>
      </div>
      <% } %>

      <!-- Google Login -->
      <a href="/auth/google" class="btn btn-google" style="display:flex;align-items:center;justify-content:center;text-decoration:none">
        <svg width="18" height="18" viewBox="0 0 24 24" style="margin-right:.5rem;flex-shrink:0">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continuar con Google
      </a>
      <p class="text-caption text-center mt-sm" style="color:var(--text-muted)">Solo socios registrados en sucursal pueden acceder</p>

      <p class="text-center mt-lg text-small">
        ¿Aún no eres socio? <a href="/hazte-socio">Hazte socio</a>
      </p>

    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
