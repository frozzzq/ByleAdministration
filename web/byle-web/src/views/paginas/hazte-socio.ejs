<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { pageTitle: 'Hazte socio' }) %></head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <section class="page-section">
      <div class="section-header text-center">
        <div class="section-label">Pre-registro</div>
        <h1 class="text-h1">Conviértete en socio</h1>
        <p class="section-desc">Llena tus datos y ve a la sucursal a completar tu inscripción. Tienes <strong>1 minuto</strong> para ir a pagar.</p>
      </div>

      <div class="max-w-sm mx-auto">

        <!-- Countdown (visible after submit) -->
        <div class="countdown-box hidden" id="countdownBox">
          <div class="text-caption mb-xs">Tiempo restante para ir a la sucursal</div>
          <div class="countdown-value" id="countdownValue">1:00</div>
          <div class="countdown-label">Si el tiempo se agota, tu pre-registro se cancelará automáticamente</div>
        </div>

        <form id="preRegistroForm" onsubmit="enviarPreRegistro(event)">

          <div class="card mb-lg">
            <h3 class="text-h3 mb-md">Datos personales</h3>
            <div class="form-group">
              <label class="form-label">Nombre completo</label>
              <input id="fNombre" type="text" class="form-input" placeholder="Tu nombre completo" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Edad</label>
                <input id="fEdad" type="number" class="form-input" placeholder="25" min="15" max="80" required>
              </div>
              <div class="form-group">
                <label class="form-label">Ciudad</label>
                <input id="fCiudad" type="text" class="form-input" placeholder="Los Mochis" value="Los Mochis">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Correo electrónico</label>
              <input id="fCorreo" type="email" class="form-input" placeholder="tu@correo.com" required>
              <p class="form-hint">Este correo será tu usuario para el portal web</p>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Teléfono</label>
                <input id="fTelefono" type="tel" class="form-input" placeholder="6681234567" required>
              </div>
              <div class="form-group">
                <label class="form-label">Teléfono de emergencia</label>
                <input id="fTelEmer" type="tel" class="form-input" placeholder="6687654321" required>
              </div>
            </div>
          </div>

          <div class="card mb-lg">
            <h3 class="text-h3 mb-md">Selecciona tu plan</h3>
            <% if (membresias.length === 0) { %>
              <p class="text-small" style="color:var(--text-muted)">No hay planes disponibles en este momento.</p>
            <% } %>
            <% membresias.forEach((m, i) => { %>
              <label class="card" style="display:flex;gap:.75rem;cursor:pointer;padding:1rem;margin-bottom:.5rem<%- m.estado === 'oferta' ? ';border-color:var(--accent)' : '' %>">
                <input type="radio" name="plan" value="<%= m.id_membresia %>"
                       <%- i === 0 ? 'checked required' : '' %>
                       style="accent-color:var(--accent);margin-top:2px;flex-shrink:0">
                <div>
                  <div class="text-h3">
                    <%= m.nombre_membresia %> — $<%= m.precio.toLocaleString('es-MX') %>/<%= m.duracion_dias >= 365 ? 'año' : m.duracion_dias >= 180 ? '6 meses' : m.duracion_dias >= 90 ? 'trimestre' : 'mes' %>
                  </div>
                  <% if (m.descripcion) { %>
                    <div class="text-small"><%= m.descripcion %></div>
                  <% } %>
                  <% if (m.estado === 'oferta') { %>
                    <div class="text-small" style="color:var(--accent);margin-top:.25rem">Precio especial</div>
                  <% } %>
                </div>
              </label>
            <% }) %>
          </div>

          <div class="alert-banner alert-warning">
            ⏰ Al enviar, tendrás <strong>1 minuto</strong> para ir a la sucursal a pagar y registrar tu huella digital.
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg" id="btnEnviar">Enviar pre-registro</button>

        </form>

      </div>
    </section>
  </div>
  <%- include('../partials/footer') %>
  <script>
    async function enviarPreRegistro(e) {
      e.preventDefault();
      const btn = document.getElementById('btnEnviar');
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      const planRadio = document.querySelector('[name="plan"]:checked');
      const body = {
        nombre_completo:     document.getElementById('fNombre').value.trim(),
        edad:                document.getElementById('fEdad').value,
        ciudad:              document.getElementById('fCiudad').value.trim() || 'Los Mochis',
        correo:              document.getElementById('fCorreo').value.trim(),
        telefono:            document.getElementById('fTelefono').value,
        telefono_emergencia: document.getElementById('fTelEmer').value,
        id_membresia:        planRadio ? planRadio.value : null,
      };

      try {
        const resp = await fetch('/api/pre-registro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await resp.json();
        if (!data.ok) throw new Error(data.error || 'Error del servidor');

        document.getElementById('preRegistroForm').querySelectorAll('input').forEach(i => i.disabled = true);
        btn.textContent = 'Pre-registro enviado ✓';
        document.getElementById('countdownBox').classList.remove('hidden');

        let total = 60;
        const timer = setInterval(() => {
          total--;
          if (total <= 0) {
            clearInterval(timer);
            document.getElementById('countdownValue').textContent = '0:00';
            document.getElementById('countdownBox').innerHTML =
              '<div class="countdown-label" style="color:#f87171">Tu pre-registro ha expirado. <a href="/hazte-socio">Intenta de nuevo</a>.</div>';
            return;
          }
          const m = Math.floor(total / 60), s = total % 60;
          document.getElementById('countdownValue').textContent = m + ':' + String(s).padStart(2, '0');
        }, 1000);

        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Enviar pre-registro';
        alert('Error al enviar: ' + err.message);
      }
    }
  </script>
</body>
</html>
