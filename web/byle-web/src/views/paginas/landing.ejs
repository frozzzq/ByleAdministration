<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/head', { pageTitle: 'Inicio' }) %></head>
<body>
  <%- include('../partials/navbar') %>

  <!-- HERO -->
  <section class="hero" id="heroSection">
    <span class="hero-orb hero-orb-1" aria-hidden="true"></span>
    <span class="hero-orb hero-orb-2" aria-hidden="true"></span>
    <img src="/img/logo.svg" alt="Byle" class="hero-logo">
    <h1 class="hero-title">BY<span>LE</span> GYM</h1>
    <p class="hero-sub">Tu centro deportivo en Los Mochis, Sinaloa</p>
    <div class="hero-actions">
      <a href="/hazte-socio" class="btn btn-primary btn-lg">Hazte socio hoy</a>
      <button id="gymInfoBtn" class="btn btn-secondary btn-lg hero-gym-btn" onclick="toggleGymInfo()">Conoce el gym</button>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><div class="hero-stat-value">350+</div><div class="hero-stat-label">Socios activos</div></div>
      <div class="hero-stat"><div class="hero-stat-value">10</div><div class="hero-stat-label">Clases grupales</div></div>
      <div class="hero-stat"><div class="hero-stat-value">5am</div><div class="hero-stat-label">Abrimos temprano</div></div>
    </div>

    <!-- Panel expandible info del gym -->
    <div class="hero-gym-panel" id="gymPanel">
      <div class="gym-panel-header">
        <span class="gym-panel-tag">Conoce Byle Gym</span>
      </div>
      <div class="gym-cards-grid">
        <div class="gym-info-card">
          <span class="gym-card-icon">🏋️</span>
          <h3>Instalaciones</h3>
          <p>Área de pesas de última generación, zona cardiovascular y espacios dedicados para clases grupales. Todo el equipo que necesitas para alcanzar tus metas.</p>
          <div class="gym-card-stat">
            <span class="gym-card-stat-val">1,200 m²</span>
            <span class="gym-card-stat-label">de espacio</span>
          </div>
          <a href="/info?s=general" class="gym-card-link">Ver instalaciones →</a>
        </div>
        <div class="gym-info-card">
          <span class="gym-card-icon">🎯</span>
          <h3>Nuestro equipo</h3>
          <p>Entrenadores certificados en fuerza, crossfit y nutrición deportiva. Estamos contigo en cada paso de tu transformación física.</p>
          <div class="gym-card-stat">
            <span class="gym-card-stat-val">8+</span>
            <span class="gym-card-stat-label">entrenadores</span>
          </div>
          <a href="/info?s=general" class="gym-card-link">Conocer al equipo →</a>
        </div>
        <div class="gym-info-card">
          <span class="gym-card-icon">📍</span>
          <h3>Ubicación y horarios</h3>
          <p>En el corazón de Los Mochis, Sinaloa. Abrimos desde las 5am de lunes a sábado para adaptarnos a tu ritmo de vida.</p>
          <div class="gym-card-stat">
            <span class="gym-card-stat-val">5am–10pm</span>
            <span class="gym-card-stat-label">Lun – Sáb</span>
          </div>
          <a href="/info?s=horarios" class="gym-card-link">Ver horarios →</a>
        </div>
      </div>
      <div class="gym-panel-footer">
        <button id="gymCloseBtn" class="gym-close-btn" onclick="toggleGymInfo()" aria-label="Cerrar panel">
          <svg class="gym-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span>Cerrar</span>
        </button>
      </div>
    </div>
  </section>

  <div class="container">

    <!-- SECCIONES RÁPIDAS -->
    <section class="page-section">
      <div class="section-header text-center">
        <div class="section-label">¿Qué encontrarás?</div>
        <h2 class="text-h1">Todo en un solo lugar</h2>
      </div>
      <div class="features-grid">
        <a href="/info?s=general" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">🏋️</div>
          <h3>Instalaciones</h3>
          <p>Conoce nuestras áreas, equipo y todo lo que ofrecemos para tu entrenamiento.</p>
        </a>
        <a href="/info?s=planes" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">💎</div>
          <h3>Planes y membresías</h3>
          <p>Encuentra el plan perfecto para tus objetivos y presupuesto.</p>
        </a>
        <a href="/tienda" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">🛒</div>
          <h3>Tienda online</h3>
          <p>Compra suplementos, accesorios y más. Recoge en sucursal.</p>
        </a>
        <a href="/competencias" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">🏆</div>
          <h3>Competencias</h3>
          <p>Ranking de constancia y records personales. ¿Quién es más dedicado?</p>
        </a>
        <a href="/info?s=horarios" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">🕐</div>
          <h3>Horarios y clases</h3>
          <p>Consulta horarios de apertura y clases grupales disponibles.</p>
        </a>
        <a href="/hazte-socio" class="feature-card" style="text-decoration:none;color:inherit">
          <div class="feature-icon">⚡</div>
          <h3>Hazte socio</h3>
          <p>Pre-regístrate online y ahorra tiempo. Solo paga en sucursal.</p>
        </a>
      </div>
    </section>

    <!-- PLANES PREVIEW -->
    <section class="page-section">
      <div class="section-header text-center">
        <div class="section-label">Membresías</div>
        <h2 class="text-h1">Elige tu plan</h2>
        <p class="section-desc">Todos incluyen acceso completo al área de pesas y cardio</p>
      </div>
      <% if (membresias && membresias.length > 0) { %>
      <div class="plans-accordion">
        <% membresias.forEach(function(plan, i) {
             const mid = Math.floor(membresias.length / 2);
             const isPopular = (membresias.length > 1 && i === mid);
             const meses = plan.duracion_dias >= 60 ? Math.round(plan.duracion_dias / 30) : null;
             const durLabel = meses ? plan.duracion_dias + ' días · ' + meses + ' meses' : plan.duracion_dias + ' días';
             const periodoLabel = meses ? '/' + meses + ' meses' : '/mes';
        %>
        <div class="plan-row">
          <div class="plan-row-header" onclick="togglePlan(this.parentElement)">
            <div class="plan-row-name">
              <%= plan.nombre_membresia %>
              <% if (isPopular) { %><span class="plan-popular-tag">Popular</span><% } %>
            </div>
            <div class="plan-row-right">
              <div class="plan-row-price-wrap">
                <span class="plan-row-price">$<%= Number(plan.precio).toLocaleString('es-MX') %></span>
                <span class="plan-row-period"><%= periodoLabel %></span>
              </div>
              <svg class="plan-row-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
          <div class="plan-row-body">
            <div class="plan-row-body-inner">
              <div class="plan-row-duration">⏱ <%= durLabel %></div>
              <ul class="plan-features">
                <li>Acceso a pesas y cardio</li>
                <li>Horario completo (5am–10pm)</li>
                <% if (isPopular) { %><li>Clases grupales incluidas</li><% } %>
                <% if (plan.duracion_dias >= 60) { %><li>Descuento por pago adelantado</li><% } %>
              </ul>
              <a href="/hazte-socio" class="btn <%= isPopular ? 'btn-primary' : 'btn-secondary' %> btn-block">Elegir este plan</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <p style="text-align:center;color:var(--text-muted);padding:2rem 0">
        Próximamente publicaremos nuestros planes. <a href="/hazte-socio">Contáctanos</a>
      </p>
      <% } %>
    </section>

    <!-- CTA FINAL -->
    <section class="page-section text-center" style="padding-bottom:2rem">
      <div class="section-label">¿Listo para empezar?</div>
      <h2 class="text-h1 mb-md">Empieza tu transformación hoy</h2>
      <p class="text-body mb-xl">Pre-regístrate online y solo ve a pagar a la sucursal. Sin filas, sin esperas.</p>
      <a href="/hazte-socio" class="btn btn-primary btn-lg">Hazte socio ahora</a>
    </section>

  </div>

  <%- include('../partials/footer') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script>
  (function () {
    const panel  = document.getElementById('gymPanel');
    const btn    = document.getElementById('gymInfoBtn');
    const cards  = panel.querySelectorAll('.gym-info-card');
    const tag    = panel.querySelector('.gym-panel-tag');
    const footer = panel.querySelector('.gym-panel-footer');
    let isOpen = false;
    let tl = null;

    gsap.set(panel, { height: 0 });
    gsap.set([tag, footer], { opacity: 0 });

    function open() {
      if (isOpen) return;
      isOpen = true;
      btn.textContent = 'Cerrar';
      btn.classList.add('active');
      if (tl) tl.kill();
      tl = gsap.timeline();
      tl.to(panel, { height: 'auto', duration: 0.5, ease: 'power3.out' })
        .to(tag, { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' }, '-=0.2')
        .fromTo(cards,
          { y: 48, opacity: 0, scale: 0.95 },
          { y: 0, opacity: 1, scale: 1, duration: 0.48, ease: 'power3.out', stagger: 0.1 },
          '-=0.05'
        )
        .to(footer, { opacity: 1, duration: 0.3, ease: 'power2.out' }, '-=0.15');
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      btn.textContent = 'Conoce el gym';
      btn.classList.remove('active');
      if (tl) tl.kill();
      tl = gsap.timeline({
        onComplete: () => {
          gsap.set(panel, { height: 0 });
          gsap.set([tag, footer], { opacity: 0 });
        }
      });
      tl.to(footer, { opacity: 0, duration: 0.15 })
        .to(cards, { y: 18, opacity: 0, scale: 0.97, duration: 0.2, stagger: 0.06, ease: 'power2.in' }, '-=0.05')
        .to(tag,   { opacity: 0, duration: 0.15 }, '-=0.1')
        .to(panel, { height: 0, duration: 0.38, ease: 'power3.in' }, '-=0.08');
    }

    window.toggleGymInfo = function () { isOpen ? close() : open(); };
  })();

  // ── Plans accordion ────────────────────────────────────
  (function () {
    gsap.set(document.querySelectorAll('.plan-row-body'), { height: 0 });
    var openRow = null;
    window.togglePlan = function (row) {
      var body = row.querySelector('.plan-row-body');
      if (row.classList.contains('open')) {
        row.classList.remove('open');
        gsap.to(body, { height: 0, duration: 0.32, ease: 'power3.inOut' });
        openRow = null;
      } else {
        if (openRow && openRow !== row) {
          openRow.classList.remove('open');
          gsap.to(openRow.querySelector('.plan-row-body'), { height: 0, duration: 0.28, ease: 'power3.inOut' });
        }
        row.classList.add('open');
        gsap.to(body, { height: 'auto', duration: 0.36, ease: 'power3.out' });
        openRow = row;
      }
    };
  })();

  // ── CountUp hero stats ──────────────────────────────────
  (function () {
    var stats = document.querySelectorAll('.hero-stat-value');
    var items = [];
    stats.forEach(function (el) {
      var text = el.textContent.trim();
      var m = text.match(/^(\d+(?:\.\d+)?)(.*)/);
      if (m) items.push({ el: el, target: parseFloat(m[1]), suffix: m[2], original: text });
    });

    function easeOutExpo(t) { return t >= 1 ? 1 : 1 - Math.pow(2, -10 * t); }

    function run(item) {
      var duration = 1400;
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var t = Math.min((ts - start) / duration, 1);
        item.el.textContent = Math.round(easeOutExpo(t) * item.target) + item.suffix;
        if (t < 1) requestAnimationFrame(step);
        else item.el.textContent = item.original;
      }
      requestAnimationFrame(step);
    }

    var heroStats = document.querySelector('.hero-stats');
    if (!heroStats || !items.length) return;
    var fired = false;
    var obs = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && !fired) {
        fired = true;
        items.forEach(function (item, idx) {
          setTimeout(function () { run(item); }, idx * 120);
        });
        obs.disconnect();
      }
    }, { threshold: 0.4 });
    obs.observe(heroStats);
  })();
  </script>
</body>
</html>
