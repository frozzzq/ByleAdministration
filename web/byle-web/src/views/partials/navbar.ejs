<!-- ══ NAVBAR ══ -->
<header class="navbar">
  <div class="navbar-inner">

    <a href="/" class="navbar-brand">
      <img src="/img/logo.svg" alt="Byle">
      <div class="navbar-brand-text">
        <div class="navbar-title">BY<span>LE</span></div>
        <div class="navbar-sub">Gym management</div>
      </div>
    </a>

    <div class="navbar-actions">
      <button class="theme-toggle" onclick="toggleTheme()" title="Cambiar tema" aria-label="Cambiar tema">☀️</button>
      <% if (locals.usuario) { %>
        <a href="/dashboard" style="display:flex;align-items:center;gap:.5rem;text-decoration:none">
          <% if (usuario.foto) { %>
          <img src="<%= usuario.foto %>" alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover;border:1.5px solid var(--accent)">
          <% } %>
          <span class="text-small" style="color:var(--text-primary);font-weight:500;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= usuario.nombre.split(' ')[0] %></span>
        </a>
        <a href="/auth/logout" class="btn btn-secondary btn-sm">Salir</a>
      <% } else { %>
        <a href="/login" class="btn btn-primary btn-sm">Ingresar</a>
      <% } %>
      <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menú">☰</button>
    </div>

  </div>
</header>

<!-- ══ MENÚ MÓVIL ══ -->
<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-header">
    <div class="navbar-title" style="font-family:'Bebas Neue';font-size:1.3rem">BY<span style="color:var(--accent)">LE</span></div>
    <button class="mobile-menu-close" onclick="toggleMenu()">✕</button>
  </div>

  <% if (locals.usuario) { %>
  <div style="display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;margin-bottom:.5rem;background:var(--bg-card);border-radius:var(--radius-sm)">
    <% if (usuario.foto) { %>
    <img src="<%= usuario.foto %>" alt="" style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:1.5px solid var(--accent);flex-shrink:0">
    <% } %>
    <div style="min-width:0">
      <div style="font-size:.875rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= usuario.nombre %></div>
      <div style="font-size:.7rem;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= usuario.correo %></div>
    </div>
  </div>
  <a href="/dashboard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>Mi portal</a>
  <a href="/mi-progreso"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>Mi progreso</a>
  <a href="/clases"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Clases</a>
  <a href="/pagos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>Mis pagos</a>
  <div class="menu-divider"></div>
  <a href="/auth/logout"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>Cerrar sesión</a>
  <% } else { %>
  <a href="/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Inicio</a>
  <a href="/hazte-socio"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Hazte socio</a>
  <div class="menu-divider"></div>
  <a href="/login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>Iniciar sesión</a>
  <% } %>
</div>
