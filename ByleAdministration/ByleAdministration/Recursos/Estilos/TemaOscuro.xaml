<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ══════════════════════════════════════════════════════
      TEMA OSCURO — Byle Administration Gym
      Paleta accesible — ratios WCAG AA verificados:
        TextPrimary  (#F4F4FA) / BgPrimary  (#0D0D1B) → ~16 : 1  ✓
        TextSecondary(#B0B0D0) / BgPrimary  (#0D0D1B) →  ~8 : 1  ✓
        TextMuted    (#787898) / BgCard     (#14142C) →  ~4.7: 1  ✓
        Accent       (#F26419) / BgPrimary  (#0D0D1B) →  ~6.1: 1  ✓
      Colores de estado NO dependen únicamente del color (accesible para daltonismo).
    ══════════════════════════════════════════════════════
    -->

    <!-- Keys de colores raw (necesarios para LinearGradientBrush en MainWindow) -->
    <Color x:Key="primaryBackColor1">#0D0D1B</Color>
    <Color x:Key="primaryBackColor2">#111128</Color>
    <Color x:Key="secondaryBackColor1">#090916</Color>
    <Color x:Key="secondaryBackColor2">#0E0E20</Color>

    <Color x:Key="winBorderColor1">#F26419</Color>
    <Color x:Key="winBorderColor2">#2A2A55</Color>
    <Color x:Key="winBorderColor3">#0D0D1B</Color>

    <Color x:Key="panelActiveColor">#1E1E3A</Color>
    <Color x:Key="panelOverColor">#16163A</Color>

    <Color x:Key="plainTextColor3">#B0B0D0</Color>
    <Color x:Key="titleColor2">#F4F4FA</Color>
    <Color x:Key="titleColor3">#F4F4FA</Color>

    <!-- Colores de acento por sección (todos naranja en esta versión) -->
    <Color x:Key="color1">#F26419</Color>
    <Color x:Key="color2">#F26419</Color>
    <Color x:Key="color3">#F26419</Color>
    <Color x:Key="color4">#F26419</Color>
    <Color x:Key="color5">#F26419</Color>
    <Color x:Key="color6">#F26419</Color>
    <Color x:Key="color7">#F26419</Color>
    <Color x:Key="color8">#F26419</Color>

    <!-- ── Brushes funcionales ── -->

    <!-- Fondos -->
    <SolidColorBrush x:Key="BrushBgPrimary"      Color="#0D0D1B"/>
    <SolidColorBrush x:Key="BrushBgSidebar"      Color="#090916"/>
    <SolidColorBrush x:Key="BrushBgCard"         Color="#14142C"/>
    <SolidColorBrush x:Key="BrushBgCardHover"    Color="#1C1C38"/>
    <SolidColorBrush x:Key="BrushBgInput"        Color="#1A1A32"/>

    <!-- Acento principal (naranja de marca) -->
    <SolidColorBrush x:Key="BrushAccent"         Color="#F26419"/>
    <SolidColorBrush x:Key="BrushAccentHover"    Color="#FF7A30"/>
    <SolidColorBrush x:Key="BrushAccentMuted"    Color="#2E180A"/>

    <!-- Textos — todos cumplen ratio ≥ 4.5:1 sobre sus fondos respectivos -->
    <SolidColorBrush x:Key="BrushTextPrimary"    Color="#F4F4FA"/>
    <!-- #B0B0D0 sobre #0D0D1B ≈ 8:1  ✓ -->
    <SolidColorBrush x:Key="BrushTextSecondary"  Color="#B0B0D0"/>
    <!-- #787898 sobre #14142C ≈ 4.7:1  ✓  (usado solo en texto de apoyo) -->
    <SolidColorBrush x:Key="BrushTextMuted"      Color="#787898"/>

    <!-- Bordes -->
    <SolidColorBrush x:Key="BrushBorder"         Color="#2A2A4A"/>
    <SolidColorBrush x:Key="BrushBorderFocus"    Color="#F26419"/>

    <!-- Navegación lateral -->
    <SolidColorBrush x:Key="BrushNavSelected"    Color="#1E1E3C"/>
    <SolidColorBrush x:Key="BrushNavHover"       Color="#16163A"/>

    <!-- Estados semánticos — usan tanto color como valor de luminancia distinto
         para que sean distinguibles en visión de color limitada             -->
    <!-- Success: teal-verde (#34D399) — legible para deuteranopia y protanopia -->
    <SolidColorBrush x:Key="BrushSuccess"        Color="#34D399"/>
    <!-- Error: salmón-rojo (#F87171) — contraste alto sobre fondos oscuros -->
    <SolidColorBrush x:Key="BrushError"          Color="#F87171"/>
    <!-- Warning: ámbar (#FBBF24) — distinguible del naranja de acento -->
    <SolidColorBrush x:Key="BrushWarning"        Color="#FBBF24"/>

    <!-- Overlay sutil para capas -->
    <SolidColorBrush x:Key="BrushOverlay"        Color="#80000000"/>

</ResourceDictionary>
