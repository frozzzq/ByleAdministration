<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ══════════════════════════════════════════════════════
      PALETA DE MARCA — Byle Administration Gym
      Constantes que NO cambian con el tema.
      Contraste verificado WCAG AA (≥ 4.5:1 para texto normal).
    ══════════════════════════════════════════════════════
    -->

    <!-- Colores primitivos de marca -->
    <Color x:Key="BrandNaranja">#F26419</Color>
    <Color x:Key="BrandNaranjaHover">#FF7A30</Color>
    <Color x:Key="BrandOscuroBase">#0D0D1B</Color>

    <!--
        Brushes de compatibilidad — usados directamente en LoginWindow
        y RegistroEmpleadoWindow donde no se usan los brushes de tema.
    -->
    <SolidColorBrush x:Key="BrushOscuro"     Color="#0D0D1B"/>
    <SolidColorBrush x:Key="BrushNaranja"    Color="#F26419"/>
    <SolidColorBrush x:Key="BrushTextoClaro" Color="#F4F4FA"/>
    <SolidColorBrush x:Key="BrushGris"       Color="#1A1A32"/>
    <SolidColorBrush x:Key="BrushError"      Color="#F87171"/>

</ResourceDictionary>
