<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ══════════════════════════════════════════════════════
      TEMA CLARO — Byle Administration Gym
      TextPrimary  (#1C1C2E) / BgPrimary  (#FAF9FF) → ~14 : 1  ✓
      TextSecondary(#4A4A6A) / BgPrimary  (#FAF9FF) →  ~7 : 1  ✓
      Accent       (#D4540E) / BgPrimary  (#FAF9FF) →  ~5 : 1  ✓
    ══════════════════════════════════════════════════════
    -->

    <Color x:Key="primaryBackColor1">#FAF9FF</Color>
    <Color x:Key="primaryBackColor2">#F3F2FC</Color>
    <Color x:Key="secondaryBackColor1">#EEEDFa</Color>
    <Color x:Key="secondaryBackColor2">#E6E5F6</Color>

    <Color x:Key="winBorderColor1">#D4540E</Color>
    <Color x:Key="winBorderColor2">#C8C8E8</Color>
    <Color x:Key="winBorderColor3">#FAF9FF</Color>

    <Color x:Key="panelActiveColor">#E2E1F5</Color>
    <Color x:Key="panelOverColor">#EDEDFB</Color>

    <Color x:Key="plainTextColor3">#8888A8</Color>
    <Color x:Key="titleColor2">#1C1C2E</Color>
    <Color x:Key="titleColor3">#1C1C2E</Color>

    <Color x:Key="color1">#D4540E</Color>
    <Color x:Key="color2">#D4540E</Color>
    <Color x:Key="color3">#D4540E</Color>
    <Color x:Key="color4">#D4540E</Color>
    <Color x:Key="color5">#D4540E</Color>
    <Color x:Key="color6">#D4540E</Color>
    <Color x:Key="color7">#D4540E</Color>
    <Color x:Key="color8">#D4540E</Color>

    <!-- Fondos -->
    <SolidColorBrush x:Key="BrushBgPrimary"      Color="#FAF9FF"/>
    <SolidColorBrush x:Key="BrushBgSidebar"      Color="#EEEDFB"/>
    <SolidColorBrush x:Key="BrushBgCard"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBgCardHover"    Color="#F3F2FC"/>
    <SolidColorBrush x:Key="BrushBgInput"        Color="#FFFFFF"/>

    <!-- Acento (naranja más oscuro para contraste sobre blanco) -->
    <SolidColorBrush x:Key="BrushAccent"         Color="#D4540E"/>
    <SolidColorBrush x:Key="BrushAccentHover"    Color="#E86010"/>
    <SolidColorBrush x:Key="BrushAccentMuted"    Color="#FDE8D8"/>

    <!-- Textos -->
    <SolidColorBrush x:Key="BrushTextPrimary"    Color="#1C1C2E"/>
    <SolidColorBrush x:Key="BrushTextSecondary"  Color="#4A4A6A"/>
    <SolidColorBrush x:Key="BrushTextMuted"      Color="#8888A8"/>

    <!-- Bordes -->
    <SolidColorBrush x:Key="BrushBorder"         Color="#D8D7EE"/>
    <SolidColorBrush x:Key="BrushBorderFocus"    Color="#D4540E"/>

    <!-- Navegación -->
    <SolidColorBrush x:Key="BrushNavSelected"    Color="#E2E1F5"/>
    <SolidColorBrush x:Key="BrushNavHover"       Color="#EDEDFB"/>

    <!-- Estados semánticos -->
    <SolidColorBrush x:Key="BrushSuccess"        Color="#059669"/>
    <SolidColorBrush x:Key="BrushError"          Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushWarning"        Color="#B45309"/>

    <SolidColorBrush x:Key="BrushOverlay"        Color="#40000000"/>

</ResourceDictionary>
