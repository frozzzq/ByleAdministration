<Application x:Class="ByleAdministration.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Vistas/Auth/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  1 → Colores de marca (no cambian con el tema)  -->
                <ResourceDictionary Source="Recursos/Estilos/Colores.xaml"/>
                <!--  2 → Tema inicial (oscuro). ThemeToggle_Click lo reemplaza en runtime  -->
                <ResourceDictionary Source="Recursos/Estilos/TemaOscuro.xaml"/>
                <!--  3 → Estilos globales (depende de los brushes del tema)  -->
                <ResourceDictionary Source="Recursos/Estilos/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
