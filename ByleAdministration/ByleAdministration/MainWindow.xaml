<Window x:Class="ByleAdministration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="Byle Administration"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!--
    ══════════════════════════════════════════════════════
      MAIN WINDOW — Shell principal de ByleAdministrationGym
      Layout: sidebar fijo 220px | área de contenido dinámica
      • Tema oscuro/claro mediante MergedDictionaries
      • Navegación con RadioButtons (GroupName="Nav")
      • Todos los textos ≥ 4.5:1 contraste sobre sus fondos
      • Hover en nav con animación suave (Estilos.xaml)
      
      CAMBIOS REALIZADOS: StaticResource → DynamicResource en colores de fondo
      para que responda al cambio dinámico de tema
    ══════════════════════════════════════════════════════
    -->

    <!-- Marco exterior con esquinas redondeadas y borde degradado de marca -->
    <Border CornerRadius="12" ClipToBounds="True" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{DynamicResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{DynamicResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════════
                 SIDEBAR
            ════════════════════════════════════════════ -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="{DynamicResource secondaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{DynamicResource secondaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel>

                    <!-- ── Logo ── -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,0,20">
                        <Grid Width="46" Height="46" Margin="0,0,0,10">
                            <fa:IconImage Icon="Shield"
                                          Width="46" Height="46"
                                          Foreground="{DynamicResource BrushAccent}"/>
                            <fa:IconImage Icon="Dumbbell"
                                          Width="17" Height="17"
                                          Foreground="White" Opacity="0.92"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,6,0,0"/>
                        </Grid>
                        <TextBlock Text="BYLE"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource BrushAccent}"/>
                        <TextBlock Text="Administration Gym"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="2,3,0,0"/>
                    </StackPanel>

                    <!-- Separador superior -->
                    <Rectangle DockPanel.Dock="Top" Height="1" Margin="16,0,16,10">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#2A2A48"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ── Zona inferior: toggle + usuario ── -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,14">

                        <!-- Separador inferior -->
                        <Rectangle Height="1" Margin="2,0,2,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#2A2A48"     Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Toggle de tema -->
                        <ToggleButton x:Name="ThemeToggle"
                                      Style="{StaticResource ThemeToggleStyle}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,10"
                                      Click="ThemeToggle_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ThemeIcon"
                                           Text="☀"
                                           FontSize="13"
                                           Margin="0,0,7,0"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock x:Name="ThemeLabel"
                                           Text="Modo claro"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Card de usuario activo -->
                        <Border CornerRadius="10" Padding="12,10" Cursor="Hand">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1C1C38" Offset="0"/>
                                    <GradientStop Color="#242444" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <!-- Avatar circular con inicial -->
                                <Border Width="36" Height="36" CornerRadius="18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F26419" Offset="0"/>
                                            <GradientStop Color="#D94F00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="A"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Nombre y rol -->
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUsuarioActivo"
                                               Text="Admin"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Administrador"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Navegación principal ── -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,0,0">

                            <RadioButton x:Name="NavDashboard"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color1}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ChartPie"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Dashboard"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAcceso"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color2}"
                                         GroupName="Nav"
                                         IsChecked="True"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="DoorOpen"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Acceso"
                                               Style="{StaticResource menuButtonText}"/>
                                    <!-- Badge "DEFAULT" -->
                                    <Border Background="{DynamicResource BrushAccent}"
                                            CornerRadius="5"
                                            Padding="5,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="★"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavVentas"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color3}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="CashRegister"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Ventas / Caja"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavClientes"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color4}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Users"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Clientes"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavMembresias"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color5}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="IdCard"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Membresías"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavClases"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color6}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="PersonRunning"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Clases y Progreso"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavReportes"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color7}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ChartBar"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Reportes"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSistema"
                                         Style="{StaticResource menuButton}"
                                         Tag="{StaticResource color8}"
                                         GroupName="Nav"
                                         Checked="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Gear"
                                                  Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="Sistema"
                                               Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════
                 ÁREA PRINCIPAL
            ════════════════════════════════════════════ -->
            <Border Grid.Column="1" CornerRadius="0,12,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource primaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{DynamicResource primaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Barra de control (minimize / close) -->
                        <RowDefinition Height="30"/>
                        <!-- Topbar (título sección + búsqueda + notificaciones) -->
                        <RowDefinition Height="62"/>
                        <!-- Contenido dinámico -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── Barra de control ── -->
                    <StackPanel Grid.Row="0"
                                x:Name="pnlControlBar"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                Background="Transparent"
                                Margin="0,4,10,0"
                                MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown">
                        <!-- Cerrar -->
                        <Button Style="{StaticResource controlButton}"
                                Click="BtnCerrar_Click"
                                ToolTip="Cerrar aplicación">
                            <fa:IconImage Icon="Xmark"
                                          Width="11" Height="11"
                                          Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Button>
                        <!-- Minimizar -->
                        <Button Style="{StaticResource controlButton}"
                                Click="BtnMinimizar_Click"
                                ToolTip="Minimizar">
                            <fa:IconImage Icon="WindowMinimize"
                                          Width="11" Height="11"
                                          Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Button>
                    </StackPanel>

                    <!-- ── Topbar ── -->
                    <Border Grid.Row="1"
                            Padding="28,0,20,0"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource primaryBackColor1}" Offset="0"/>
                                <GradientStop Color="{DynamicResource primaryBackColor2}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <DockPanel VerticalAlignment="Center">

                            <!-- Nombre de sección actual -->
                            <StackPanel DockPanel.Dock="Left"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSeccionActual"
                                           Text="Acceso"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Acciones lado derecho -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <!-- Buscador global -->
                                <Border Height="36" Width="230"
                                        Background="{DynamicResource BrushBgInput}"
                                        CornerRadius="9"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <fa:IconImage Grid.Column="0"
                                                      Icon="MagnifyingGlass"
                                                      Width="13" Height="13"
                                                      Foreground="{DynamicResource BrushTextMuted}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource SearchBoxStyle}"
                                                 Foreground="{DynamicResource BrushTextMuted}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 FontSize="12.5"
                                                 Padding="0,0,8,0"
                                                 Text="Buscar..."/>
                                    </Grid>
                                </Border>

                                <!-- Notificaciones -->
                                <Border Width="36" Height="36"
                                        CornerRadius="9"
                                        Cursor="Hand"
                                        Margin="10,0,0,0"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        Background="{DynamicResource BrushBgCard}"
                                        ToolTip="Notificaciones">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource BrushBgCardHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <fa:IconImage Icon="Bell"
                                                  Width="14" Height="14"
                                                  Foreground="{DynamicResource BrushTextSecondary}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                </Border>

                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ── Contenido dinámico ── -->
                    <ContentControl x:Name="MainContent"
                                    Grid.Row="2"
                                    Margin="0"/>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
