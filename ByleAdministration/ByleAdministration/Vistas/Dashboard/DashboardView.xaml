<UserControl x:Class="ByleAdministration.Vistas.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,22">

            <!-- ── SALUDO + FECHA ── -->
            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}">
                        <Run Text="¡Buenos días, "/>
                        <Run Text="Admin" Foreground="{DynamicResource BrushAccent}"/>
                        <Run Text="!"/>
                    </TextBlock>
                    <TextBlock Text="Aquí tienes el resumen del gimnasio de hoy."
                               FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="CalendarDay" Width="13" Height="13"
                                      Foreground="{DynamicResource BrushAccent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Jueves, 8 de mayo de 2026"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- ── 4 TARJETAS DE MÉTRICAS ── -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                <!-- Clientes activos -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#22F26419" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <fa:IconImage Icon="Users" Width="18" Height="18" Foreground="#F26419"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="148" FontSize="30" FontWeight="Black"
                                       Foreground="{DynamicResource BrushTextPrimary}" LineHeight="30"/>
                            <TextBlock Text="Clientes activos" FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,23"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#1A34D399" CornerRadius="6" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ArrowUp" Width="9" Height="9"
                                              Foreground="#34D399" Margin="0,0,4,0"/>
                                <TextBlock Text="+5%" FontSize="10.5" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ingresos del mes -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#2234D399" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <fa:IconImage Icon="MoneyBillWave" Width="18" Height="18"
                                              Foreground="#34D399"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="$18,450" FontSize="26" FontWeight="Black"
                                       Foreground="{DynamicResource BrushTextPrimary}" LineHeight="30"/>
                            <TextBlock Text="Ingresos del mes" FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#1A34D399" CornerRadius="6" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ArrowUp" Width="9" Height="9"
                                              Foreground="#34D399" Margin="0,0,4,0"/>
                                <TextBlock Text="+12%" FontSize="10.5" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ventas de hoy -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#22FBBF24" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <fa:IconImage Icon="CashRegister" Width="18" Height="18"
                                              Foreground="#FBBF24"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="12" FontSize="30" FontWeight="Black"
                                       Foreground="{DynamicResource BrushTextPrimary}" LineHeight="30"/>
                            <TextBlock Text="Ventas de hoy" FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#1AFBBF24" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="$3,240" FontSize="10.5" FontWeight="Bold" Foreground="#FBBF24"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Membresías por vencer -->
                <Border Margin="0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="#22F87171" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <fa:IconImage Icon="TriangleExclamation" Width="18" Height="18"
                                              Foreground="#F87171"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="8" FontSize="30" FontWeight="Black"
                                       Foreground="{DynamicResource BrushTextPrimary}" LineHeight="30"/>
                            <TextBlock Text="Membresías por vencer" FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#1AF87171" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="esta semana" FontSize="10.5" FontWeight="Bold" Foreground="#F87171"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ── PANELES INFERIORES ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Accesos recientes -->
                <Border Grid.Column="0" CornerRadius="12" Padding="20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="ACCESOS RECIENTES" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="Últimas entradas del día" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource BrushAccentMuted}" CornerRadius="7"
                                    Padding="10,5" Cursor="Hand">
                                <TextBlock Text="Ver bitácora completa" FontSize="11"
                                           Foreground="{DynamicResource BrushAccent}"/>
                            </Border>
                        </DockPanel>

                        <!-- Item helper template inline -->
                        <StackPanel>
                            <!-- Row: Juan García ENTRADA -->
                            <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,4"
                                    Background="{DynamicResource BrushBgPrimary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E3C">
                                        <TextBlock Text="JG" FontSize="11" FontWeight="Bold" Foreground="#F26419"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Juan García" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Membresía Premium" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#1A34D399" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="ENTRADA" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Text="10:35 AM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row: María López ENTRADA -->
                            <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,4"
                                    Background="{DynamicResource BrushBgPrimary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E3C">
                                        <TextBlock Text="ML" FontSize="11" FontWeight="Bold" Foreground="#F26419"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="María López" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Membresía Estándar" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#1A34D399" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="ENTRADA" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Text="10:22 AM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row: Carlos Ruiz SALIDA -->
                            <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,4"
                                    Background="{DynamicResource BrushBgPrimary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E3C">
                                        <TextBlock Text="CR" FontSize="11" FontWeight="Bold" Foreground="#F26419"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Carlos Ruiz" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Membresía Básico" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#1AF26419" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="SALIDA" FontSize="9.5" FontWeight="Bold" Foreground="#F26419"/>
                                        </Border>
                                        <TextBlock Text="10:18 AM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row: Ana Torres ENTRADA -->
                            <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,4"
                                    Background="{DynamicResource BrushBgPrimary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E3C">
                                        <TextBlock Text="AT" FontSize="11" FontWeight="Bold" Foreground="#F26419"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ana Torres" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Membresía Premium" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#1A34D399" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="ENTRADA" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Text="10:05 AM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row: Roberto Vega ENTRADA -->
                            <Border Padding="12,10" CornerRadius="8"
                                    Background="{DynamicResource BrushBgPrimary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#1E1E3C">
                                        <TextBlock Text="RV" FontSize="11" FontWeight="Bold" Foreground="#F26419"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Roberto Vega" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="Membresía Estándar" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Background="#1A34D399" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="ENTRADA" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Text="09:52 AM" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Membresías por vencer -->
                <Border Grid.Column="2" CornerRadius="12" Padding="20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="POR VENCER" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="Renovaciones urgentes" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,16"/>

                        <!-- Patricia Mora - 2 días -->
                        <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,6"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Patricia Mora" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Membresía Estándar" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22F87171" CornerRadius="7"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="2 días" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Luis Hernández - 3 días -->
                        <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,6"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Luis Hernández" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Membresía Básico" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22F87171" CornerRadius="7"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="3 días" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Carmen Pérez - 5 días -->
                        <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,6"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Carmen Pérez" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Membresía Premium" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22FBBF24" CornerRadius="7"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="5 días" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Ricardo Soto - 6 días -->
                        <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,6"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ricardo Soto" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Membresía Básico" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22FBBF24" CornerRadius="7"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="6 días" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Sofía Martínez - 7 días -->
                        <Border Padding="12,10" CornerRadius="8"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sofía Martínez" FontSize="12.5" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Membresía Estándar" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22FBBF24" CornerRadius="7"
                                        Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="7 días" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Botón ver todos -->
                        <Button Margin="0,14,0,0"
                                Style="{StaticResource BtnSecundario}"
                                Content="Ver todos los vencimientos"
                                HorizontalAlignment="Stretch"
                                Padding="0,10"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
