<UserControl x:Class="ByleAdministration.Vistas.Acceso.AccesoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ── ENCABEZADO ── -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Control de Acceso" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Registra la entrada y salida de clientes mediante huella digital o búsqueda manual."
                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Indicador de estado del sensor -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0"/>
                    <TextBlock Text="Sensor biométrico activo" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ── PANEL IZQUIERDO: búsqueda + sensor + tarjeta cliente ── -->
        <StackPanel Grid.Row="1" Grid.Column="0">

            <!-- Búsqueda manual -->
            <Border CornerRadius="12" Padding="20"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="BÚSQUEDA MANUAL" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BrushBgInput}"
                                CornerRadius="9" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" Height="42">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:IconImage Icon="MagnifyingGlass" Width="14" Height="14"
                                              Foreground="{DynamicResource BrushTextMuted}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource BrushTextMuted}"
                                         VerticalAlignment="Center" FontSize="13"
                                         Padding="0,0,10,0"
                                         Text="Buscar por nombre, ID o teléfono..."/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                Height="42" Padding="18,0" Content="Buscar"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sensor biométrico -->
            <Border CornerRadius="12" Padding="24,20"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SENSOR BIOMÉTRICO" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Botón circular del sensor -->
                        <Border Width="90" Height="90" CornerRadius="45"
                                HorizontalAlignment="Center" Margin="0,0,0,12" Cursor="Hand">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.3">
                                    <GradientStop Color="#2EF26419" Offset="0"/>
                                    <GradientStop Color="#0AF26419" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F26419" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <Border CornerRadius="45" BorderBrush="#F26419" BorderThickness="2">
                                <fa:IconImage Icon="Fingerprint" Width="44" Height="44"
                                              Foreground="#F26419"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <TextBlock Text="Acercar dedo al sensor..." FontSize="12.5"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="El sistema identificará al cliente automáticamente"
                                   FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarjeta de cliente identificado -->
            <Border CornerRadius="12" Padding="20"
                    BorderBrush="#F26419" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1AF26419" Offset="0"/>
                        <GradientStop Color="#08F26419" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="CLIENTE IDENTIFICADO" FontSize="11" FontWeight="Bold"
                               Foreground="#F26419" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Avatar -->
                        <Border Width="52" Height="52" CornerRadius="26">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F26419" Offset="0"/>
                                    <GradientStop Color="#D94F00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="JG" FontSize="18" FontWeight="Black" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Info del cliente -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Juan García" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="#1A34D399" CornerRadius="5" Padding="7,3">
                                    <TextBlock Text="ACTIVO" FontSize="9.5" FontWeight="Bold"
                                               Foreground="#34D399"/>
                                </Border>
                                <TextBlock Text="Membresía Premium" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Vence: 30 de mayo de 2026" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- Botones de acción -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BtnPrimario}"
                                Height="44" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RightToBracket" Width="14" Height="14"
                                              Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="REGISTRAR ENTRADA" Foreground="White"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnSecundario}"
                                Height="44" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RightFromBracket" Width="14" Height="14"
                                              Foreground="{DynamicResource BrushAccent}" Margin="0,0,8,0"/>
                                <TextBlock Text="REGISTRAR SALIDA"
                                           Foreground="{DynamicResource BrushAccent}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── PANEL DERECHO: bitácora del día ── -->
        <Border Grid.Row="1" Grid.Column="2" CornerRadius="12" Padding="18"
                Background="{DynamicResource BrushBgCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <DockPanel>
                <!-- Header bitácora -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Bitácora del día" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Background="{DynamicResource BrushAccentMuted}"
                                CornerRadius="6" Padding="8,3">
                            <TextBlock Text="Hoy" FontSize="10.5"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="#1A34D399" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="32 entradas" FontSize="10.5" Foreground="#34D399"/>
                        </Border>
                        <Border Background="#1AF26419" CornerRadius="6" Padding="8,3">
                            <TextBlock Text="28 salidas" FontSize="10.5" Foreground="#F26419"/>
                        </Border>
                    </StackPanel>
                    <!-- Separador -->
                    <Rectangle Height="1" Margin="0,12,0,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>

                <!-- Lista de accesos scrollable -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Acceso 1 -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="JG" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Juan García" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="10:35 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A34D399" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Acceso 2 -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="ML" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="María López" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="10:22 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A34D399" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Acceso 3 - salida -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="CR" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Carlos Ruiz" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="10:18 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1AF26419" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↑" FontSize="11" FontWeight="Bold" Foreground="#F26419"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Acceso 4 -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="AT" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ana Torres" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="10:05 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A34D399" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Acceso 5 -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="RV" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Roberto Vega" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="09:52 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A34D399" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Más entradas -->
                        <Border Padding="10,9" CornerRadius="8" Margin="0,0,0,4"
                                Background="{DynamicResource BrushBgPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#1E1E3C">
                                    <TextBlock Text="SM" FontSize="10" FontWeight="Bold" Foreground="#F26419"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sofía Martínez" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="09:40 AM" FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A34D399" CornerRadius="5"
                                        Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
