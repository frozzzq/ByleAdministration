<UserControl x:Class="ByleAdministration.Vistas.Acceso.AccesoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Storyboard x:Key="SbIdle" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SensorGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.20" To="0.50" Duration="0:0:1.8"/>
        </Storyboard>
        <Storyboard x:Key="SbEscaneando" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SensorGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1.0" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="SensorIcono"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1.0" To="1.14" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="SensorIcono"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1.0" To="1.14" Duration="0:0:0.35"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ IZQUIERDA ══════════ -->
        <DockPanel Grid.Column="0">

            <!-- Encabezado -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Control de Acceso" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Registra la entrada y salida mediante huella o búsqueda manual."
                               FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" CornerRadius="20" Padding="14,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush x:Name="BrushEstadoFondo" Color="#1A2ECC71"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotSensor" Width="7" Height="7" Margin="0,0,7,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="BrushDotSensor" Color="#2ECC71"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtEstadoSensor" Text="Sensor biométrico activo"
                                   FontSize="11.5" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="BrushTextoSensor" Color="#2ECC71"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top">

                <!-- Búsqueda manual -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BÚSQUEDA MANUAL" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BrushBgInput}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <fa:IconImage Icon="MagnifyingGlass" Width="13" Height="13"
                                                  Foreground="{DynamicResource BrushTextMuted}"
                                                  HorizontalAlignment="Center"/>
                                    <TextBox x:Name="TxtBusquedaManual" Grid.Column="1"
                                             Height="40" BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource BrushTextPrimary}"
                                             CaretBrush="{DynamicResource BrushAccent}"
                                             FontSize="12.5" VerticalContentAlignment="Center"
                                             KeyDown="TxtBusqueda_KeyDown"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                    Height="42" Click="BtnBuscar_Click">
                                <TextBlock Text="Buscar" FontWeight="Bold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sensor biométrico -->
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="18,20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SENSOR BIOMÉTRICO" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16"/>

                        <Grid HorizontalAlignment="Center" Width="130" Height="130" Margin="0,0,0,14">
                            <Ellipse x:Name="SensorGlow" Width="130" Height="130" Opacity="0.25">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowStop" Color="#F26419" Offset="0.3"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="96" Height="96"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="BrushCirculo" Color="#1AF26419"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="SensorShadow" Color="#F26419"
                                                      BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <fa:IconImage x:Name="SensorIcono" Icon="Fingerprint"
                                         Width="46" Height="46"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                <fa:IconImage.Foreground>
                                    <SolidColorBrush x:Name="BrushIcono" Color="#F26419"/>
                                </fa:IconImage.Foreground>
                                <fa:IconImage.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </fa:IconImage.RenderTransform>
                            </fa:IconImage>
                        </Grid>

                        <TextBlock x:Name="TxtSensorMensaje" Text="Acercar dedo al sensor..."
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="BrushMensaje" Color="#F0F0F5"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock x:Name="TxtSensorSub"
                                   Text="El sistema identificará al cliente automáticamente"
                                   FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta cliente identificado -->
                <Border x:Name="BorderCard" Visibility="Collapsed"
                        CornerRadius="12" Padding="18,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#18F26419" Offset="0"/>
                            <GradientStop Color="#08F26419" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="BrushBordeCard" Color="#F26419"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1</Thickness>
                    </Border.BorderThickness>
                    <StackPanel>

                        <!-- Label arriba -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" x:Name="TxtCardLabel"
                                       Text="CLIENTE IDENTIFICADO" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                            <!-- Alerta vencimiento próximo -->
                            <Border x:Name="BorderAlerta" DockPanel.Dock="Right"
                                    Visibility="Collapsed"
                                    Background="#3DF39C12" CornerRadius="6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="TriangleExclamation" Width="10" Height="10"
                                                  Foreground="#F39C12" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtAlerta" Text="Membresía por vencer"
                                               FontSize="10" FontWeight="Bold" Foreground="#F39C12"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Info cliente -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Margin="0,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F26419" Offset="0"/>
                                        <GradientStop Color="#D94F00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="TxtCardIniciales" Text="??"
                                           FontSize="18" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCardNombre" Text="—"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                                    <Border x:Name="BorderEstadoCard"
                                            Background="#1A2ECC71" CornerRadius="6" Padding="7,3">
                                        <TextBlock x:Name="TxtEstadoCard" Text="ACTIVO"
                                                   FontSize="9" FontWeight="Bold" Foreground="#2ECC71"/>
                                    </Border>
                                    <TextBlock x:Name="TxtCardMembresia" Text="—"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="CalendarCheck" Width="11" Height="11"
                                                  Foreground="{DynamicResource BrushTextMuted}"
                                                  Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtCardVencimiento" Text="Vence: —"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Botones entrada / salida -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnEntrada" Grid.Column="0"
                                    Style="{StaticResource BtnPrimario}" Height="44"
                                    Click="BtnEntrada_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="RightToBracket" Width="13" Height="13"
                                                  Foreground="White" Margin="0,0,7,0"/>
                                    <TextBlock Text="REGISTRAR ENTRADA" Foreground="White"
                                               FontWeight="Bold" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSalida" Grid.Column="2"
                                    Style="{StaticResource BtnSecundario}" Height="44"
                                    Click="BtnSalida_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="RightFromBracket" Width="13" Height="13"
                                                  Foreground="{DynamicResource BrushAccent}"
                                                  Margin="0,0,7,0"/>
                                    <TextBlock Text="REGISTRAR SALIDA"
                                               Foreground="{DynamicResource BrushAccent}"
                                               FontWeight="Bold" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ══════════ DERECHA — bitácora ══════════ -->
        <Border Grid.Column="2" Background="{DynamicResource BrushBgCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="12" ClipToBounds="True">
            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="18,16,18,14"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Bitácora del día"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource BrushAccentMuted}"
                                CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock Text="Hoy" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Contadores -->
                <Border DockPanel.Dock="Top" Padding="14,14"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Entradas -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtEntradasHoy" Text="0"
                                       FontSize="24" FontWeight="Black" Foreground="#2ECC71"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:IconImage Icon="ArrowDown" Width="9" Height="9"
                                              Foreground="#2ECC71" Margin="0,0,4,0"/>
                                <TextBlock Text="entradas" FontSize="10"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Dentro ahora -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource BrushBgPrimary}"
                                    CornerRadius="10" Padding="12,6" HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock x:Name="TxtPersonasDentro" Text="0"
                                               FontSize="30" FontWeight="Black"
                                               Foreground="{DynamicResource BrushAccent}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="en el local" FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Salidas -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtSalidasHoy" Text="0"
                                       FontSize="24" FontWeight="Black"
                                       Foreground="{DynamicResource BrushAccent}"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:IconImage Icon="ArrowUp" Width="9" Height="9"
                                              Foreground="{DynamicResource BrushAccent}"
                                              Margin="0,0,4,0"/>
                                <TextBlock Text="salidas" FontSize="10"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lista de eventos -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelBitacora" Margin="0,4,0,4"/>
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
