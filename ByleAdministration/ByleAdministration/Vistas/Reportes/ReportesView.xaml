<UserControl x:Class="ByleAdministration.Vistas.Reportes.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,22">

            <!-- ── ENCABEZADO ── -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Reportes y Métricas" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Análisis de ingresos, ventas y asistencia del gimnasio."
                               FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ── FILTROS DE PERÍODO ── -->
            <Border CornerRadius="12" Padding="18,10"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Período:" FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Hoy (activo por defecto) -->
                    <Border x:Name="BtnHoy" Tag="hoy"
                            Background="{DynamicResource BrushAccentMuted}"
                            CornerRadius="8" Padding="14,7" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnPeriodo_Click">
                        <TextBlock Text="Hoy" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushAccent}"/>
                    </Border>

                    <Border x:Name="BtnSemana" Tag="semana"
                            Background="{DynamicResource BrushBgPrimary}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,7" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnPeriodo_Click">
                        <TextBlock Text="Esta semana" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <Border x:Name="BtnMes" Tag="mes"
                            Background="{DynamicResource BrushBgPrimary}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,7" Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonDown="BtnPeriodo_Click">
                        <TextBlock Text="Este mes" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <Border x:Name="BtnPersonalizado" Tag="personalizado"
                            Background="{DynamicResource BrushBgPrimary}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,7" Cursor="Hand"
                            MouseLeftButtonDown="BtnPeriodo_Click">
                        <TextBlock Text="Personalizado" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Border>

                    <Rectangle Width="1" Margin="14,0" Fill="{DynamicResource BrushBorder}"/>

                    <!-- Rango de fechas -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Del:" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                                Padding="8,2" Margin="0,0,8,0">
                            <DatePicker x:Name="DpDesde" Width="100" Height="28"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="12" IsEnabled="False">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Background"  Value="Transparent"/>
                                        <Setter Property="Foreground"  Value="{DynamicResource BrushTextSecondary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding"     Value="2,0"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </Border>
                        <TextBlock Text="Al:" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                                Padding="8,2" Margin="0,0,12,0">
                            <DatePicker x:Name="DpHasta" Width="100" Height="28"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="12" IsEnabled="False">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Background"  Value="Transparent"/>
                                        <Setter Property="Foreground"  Value="{DynamicResource BrushTextSecondary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding"     Value="2,0"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </Border>
                        <Button Style="{StaticResource BtnPrimario}" Padding="14,7"
                                Click="BtnAplicar_Click">
                            <TextBlock Text="Aplicar"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 4 MÉTRICAS ── -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                <!-- Ingresos totales -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#2234D399" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="DollarSign" Width="18" Height="18" Foreground="#34D399"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtIngresos" Text="$0" FontSize="24" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Ingresos totales" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtIngresosVar" Text="—" FontSize="10.5"
                                   Foreground="#34D399" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ventas registradas -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#22F26419" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="Receipt" Width="18" Height="18" Foreground="#F26419"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtVentasNum" Text="0" FontSize="28" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Ventas registradas" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtVentasVar" Text="—" FontSize="10.5"
                                   Foreground="#34D399" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Clientes nuevos -->
                <Border Margin="0,0,10,0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#22FBBF24" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="UserPlus" Width="18" Height="18" Foreground="#FBBF24"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtClientesNum" Text="0" FontSize="28" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Clientes nuevos" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtClientesVar" Text="—" FontSize="10.5"
                                   Foreground="#34D399" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Renovaciones -->
                <Border Margin="0" CornerRadius="12" Padding="18,16"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="#22F87171" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="ArrowsRotate" Width="18" Height="18" Foreground="#F26419"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtRenovNum" Text="0" FontSize="28" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Renovaciones" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtRenovVar" Text="—" FontSize="10.5"
                                   Foreground="#F87171" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ── TABLAS ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas recientes -->
                <Border Grid.Column="0" CornerRadius="12" Padding="20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="VENTAS RECIENTES" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="Últimas transacciones" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Cabecera tabla -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cliente / Concepto" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="Fecha" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Monto" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Rectangle Height="1" Margin="0,0,0,8">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{StaticResource winBorderColor2}"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Filas dinámicas -->
                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ListaTransacciones"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Top membresías + productos -->
                <Border Grid.Column="2" CornerRadius="12" Padding="20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOP MEMBRESÍAS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="Más vendidas del período" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" Margin="0,3,0,14"/>

                        <!-- Barras dinámicas -->
                        <StackPanel x:Name="ListaTopMembresias"/>

                        <Rectangle Height="1" Margin="0,6,0,14">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock Text="Productos más vendidos" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10"/>

                        <!-- Filas dinámicas -->
                        <StackPanel x:Name="ListaTopProductos"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
