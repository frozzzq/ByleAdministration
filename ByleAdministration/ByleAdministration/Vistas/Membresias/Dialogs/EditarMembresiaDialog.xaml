<Window x:Class="ByleAdministration.Vistas.Membresias.Dialogs.EditarMembresiaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
    <Border CornerRadius="16"
            Background="{DynamicResource BrushBgCard}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>

            <!-- Barra de título -->
            <Border CornerRadius="16,16,0,0" Padding="24,18,18,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="30" Height="30"
                            Background="Transparent" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" Cursor="Hand" FontSize="13"
                            Foreground="{DynamicResource BrushTextMuted}"
                            Click="BtnCerrar_Click" VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitulo" Text="Nuevo plan" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Completa los datos del plan de membresía." FontSize="11.5"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Formulario -->
            <StackPanel Padding="24,4,24,24">

                <!-- Nombre -->
                <TextBlock Text="Nombre del plan" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <TextBox x:Name="TxtNombre" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"
                             Padding="12,10" CaretBrush="{DynamicResource BrushAccent}"/>
                </Border>

                <!-- Precio + Duración -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Precio ($)" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <TextBox x:Name="TxtPrecio" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"
                                     Padding="12,10" CaretBrush="{DynamicResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Duración (días)" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <TextBox x:Name="TxtDias" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"
                                     Padding="12,10" CaretBrush="{DynamicResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Descripción -->
                <TextBlock Text="Descripción (opcional)" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        Margin="0,0,0,16">
                    <TextBox x:Name="TxtDescripcion" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5"
                             Padding="12,10" Height="72" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             CaretBrush="{DynamicResource BrushAccent}"/>
                </Border>

                <!-- Estado -->
                <TextBlock Text="Estado" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BrushBgInput}" CornerRadius="8"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        Margin="0,0,0,24" Padding="4,2">
                    <ComboBox x:Name="CmbEstado" Background="Transparent" BorderThickness="0"
                              FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}"
                              Padding="8,6">
                        <ComboBoxItem Content="activa"    IsSelected="True"/>
                        <ComboBoxItem Content="inactiva"/>
                        <ComboBoxItem Content="oferta"/>
                        <ComboBoxItem Content="temporada"/>
                    </ComboBox>
                </Border>

                <!-- Botones -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnSecundario}"
                            Content="Cancelar" Padding="0,11" Click="BtnCancelar_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                            Content="Guardar" Padding="0,11" Click="BtnGuardar_Click"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
