<UserControl x:Class="ByleAdministration.Vistas.Membresias.MembresiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── ENCABEZADO ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Membresías" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Administra los planes y tarifas del gimnasio."
                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimario}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="BtnNuevoPlan_Click">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="Plus" Width="13" Height="13"
                                  Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo plan" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ── FILTROS ── -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Búsqueda -->
            <Border Background="{DynamicResource BrushBgCard}"
                    CornerRadius="9" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <fa:IconImage Icon="MagnifyingGlass" Width="13" Height="13"
                                  Foreground="{DynamicResource BrushTextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBuscar" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             VerticalAlignment="Center" FontSize="12.5" Padding="0,0,10,0"
                             TextChanged="TxtBuscar_TextChanged"/>
                </Grid>
            </Border>

            <!-- Filtros de estado -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border x:Name="BtnFiltroTodos" Tag="todos"
                        Background="{DynamicResource BrushAccentMuted}"
                        CornerRadius="8" Padding="14,9" Margin="0,0,6,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnFiltro_Click">
                    <TextBlock Text="Todos" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource BrushAccent}"/>
                </Border>
                <Border x:Name="BtnFiltroActivos" Tag="activos"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Margin="0,0,6,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnFiltro_Click">
                    <TextBlock Text="Activos" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                <Border x:Name="BtnFiltroInactivos" Tag="inactivos"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Cursor="Hand"
                        MouseLeftButtonDown="BtnFiltro_Click">
                    <TextBlock Text="Inactivos" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── PANEL DINÁMICO DE PLANES ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PanelMembresias" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</UserControl>
