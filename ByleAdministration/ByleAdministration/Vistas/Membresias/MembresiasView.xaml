<UserControl x:Class="ByleAdministration.Vistas.Membresias.MembresiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── ENCABEZADO ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Membresías" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Administra los planes y tarifas del gimnasio."
                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimario}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="Plus" Width="13" Height="13"
                                  Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo plan" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ── FILTROS ── -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource BrushBgCard}"
                    CornerRadius="9" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <fa:IconImage Icon="MagnifyingGlass" Width="13" Height="13"
                                  Foreground="{DynamicResource BrushTextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextMuted}"
                             VerticalAlignment="Center" FontSize="12.5" Padding="0,0,10,0"
                             Text="Buscar plan..."/>
                </Grid>
            </Border>
            <!-- Filtro estado -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Background="{DynamicResource BrushAccentMuted}" CornerRadius="8"
                        Padding="14,9" Margin="0,0,6,0" Cursor="Hand">
                    <TextBlock Text="Todos" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource BrushAccent}"/>
                </Border>
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Margin="0,0,6,0" Cursor="Hand">
                    <TextBlock Text="Activos" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Cursor="Hand">
                    <TextBlock Text="Inactivos" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── GRID DE PLANES ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel>

                <!-- Plan: Básico -->
                <Border Width="230" Margin="0,0,16,16" CornerRadius="14" Padding="22,20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#22F26419"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="IdCard" Width="20" Height="20" Foreground="#F26419"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Básico" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock Text="$" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccent}" Margin="0,6,2,0"/>
                            <TextBlock Text="399" FontSize="32" FontWeight="Black"
                                       Foreground="{DynamicResource BrushAccent}"/>
                            <TextBlock Text="/mes" FontSize="12"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="4,18,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="30 días de acceso" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Horario completo" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Xmark" Width="11" Height="11" Foreground="#F87171"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Sin clases grupales" FontSize="12"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,10,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Background="#1A34D399" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="● ACTIVA" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <TextBlock Text="128 clientes" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecundario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Editar"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Asignar"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Plan: Estándar -->
                <Border Width="230" Margin="0,0,16,16" CornerRadius="14" Padding="22,20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#22F26419"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="IdCard" Width="20" Height="20" Foreground="#F26419"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Estándar" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock Text="$" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccent}" Margin="0,6,2,0"/>
                            <TextBlock Text="649" FontSize="32" FontWeight="Black"
                                       Foreground="{DynamicResource BrushAccent}"/>
                            <TextBlock Text="/mes" FontSize="12"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="4,18,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="30 días de acceso" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Clases grupales incluidas" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Horario completo" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,10,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Background="#1A34D399" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="● ACTIVA" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <TextBlock Text="89 clientes" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecundario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Editar"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Asignar"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Plan: Premium (destacado) -->
                <Border Width="230" Margin="0,0,16,16" CornerRadius="14" Padding="22,20"
                        BorderBrush="#F26419" BorderThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1CF26419" Offset="0"/>
                            <GradientStop Color="#08F26419" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#22FBBF24"
                                    HorizontalAlignment="Left" DockPanel.Dock="Left">
                                <fa:IconImage Icon="Star" Width="20" Height="20" Foreground="#FBBF24"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Background="#FBBF24" CornerRadius="6"
                                    Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <TextBlock Text="POPULAR" FontSize="9" FontWeight="Black" Foreground="#0D0D1B"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Premium" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock Text="$" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccent}" Margin="0,6,2,0"/>
                            <TextBlock Text="899" FontSize="32" FontWeight="Black"
                                       Foreground="{DynamicResource BrushAccent}"/>
                            <TextBlock Text="/mes" FontSize="12"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="4,18,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#F26419" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Acceso total" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Todas las clases grupales" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Asesoría nutricional" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,10,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#F26419" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Background="#1A34D399" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="● ACTIVA" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <TextBlock Text="45 clientes" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecundario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Editar"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Asignar"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Plan: Semestral -->
                <Border Width="230" Margin="0,0,16,16" CornerRadius="14" Padding="22,20"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="12" Background="#2234D399"
                                HorizontalAlignment="Left" Margin="0,0,0,14">
                            <fa:IconImage Icon="CalendarCheck" Width="20" Height="20" Foreground="#34D399"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Semestral" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock Text="$" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#34D399" Margin="0,6,2,0"/>
                            <TextBlock Text="3,200" FontSize="32" FontWeight="Black" Foreground="#34D399"/>
                            <TextBlock Text="/6 meses" FontSize="12"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="4,18,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="180 días de acceso" FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Check" Width="11" Height="11" Foreground="#34D399"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Ahorra $694 vs mensual" FontSize="12"
                                           Foreground="#34D399"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,10,0,12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Background="#1A34D399" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="● ACTIVA" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                            <TextBlock Text="18 clientes" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecundario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Editar"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimario}"
                                    Padding="0,9" FontSize="12" HorizontalAlignment="Stretch" Content="Asignar"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
