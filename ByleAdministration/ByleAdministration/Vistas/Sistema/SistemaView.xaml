<UserControl x:Class="ByleAdministration.Vistas.Sistema.SistemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── ENCABEZADO ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sistema" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <Border Background="{DynamicResource BrushAccentMuted}" CornerRadius="6"
                            Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ShieldHalved" Width="11" Height="11"
                                          Foreground="{DynamicResource BrushAccent}" Margin="0,0,5,0"/>
                            <TextBlock Text="Solo Administrador" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Administra los empleados y permisos del sistema."
                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimario}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="UserPlus" Width="14" Height="14"
                                  Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo empleado" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ── TARJETAS DE RESUMEN ── -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,20">
            <Border Margin="0,0,10,0" CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#22F26419" Margin="0,0,12,0">
                        <fa:IconImage Icon="Users" Width="16" Height="16" Foreground="#F26419"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="3" FontSize="20" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Empleados activos" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#2234D399" Margin="0,0,12,0">
                        <fa:IconImage Icon="ShieldHalved" Width="16" Height="16" Foreground="#34D399"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="1" FontSize="20" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Administradores" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0" CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#22FBBF24" Margin="0,0,12,0">
                        <fa:IconImage Icon="Headset" Width="16" Height="16" Foreground="#FBBF24"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="2" FontSize="20" FontWeight="Black"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Recepcionistas" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── BARRA DE BÚSQUEDA Y FILTROS ── -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource BrushBgCard}"
                    CornerRadius="9" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <fa:IconImage Icon="MagnifyingGlass" Width="13" Height="13"
                                  Foreground="{DynamicResource BrushTextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextMuted}"
                             VerticalAlignment="Center" FontSize="12.5" Padding="0,0,10,0"
                             Text="Buscar empleado..."/>
                </Grid>
            </Border>
            <!-- Filtro rol -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Background="{DynamicResource BrushAccentMuted}" CornerRadius="8"
                        Padding="14,9" Margin="0,0,6,0" Cursor="Hand">
                    <TextBlock Text="Todos" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource BrushAccent}"/>
                </Border>
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Margin="0,0,6,0" Cursor="Hand">
                    <TextBlock Text="Administradores" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                <Border Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Cursor="Hand">
                    <TextBlock Text="Recepcionistas" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── TABLA DE EMPLEADOS ── -->
        <Border Grid.Row="3" CornerRadius="12"
                Background="{DynamicResource BrushBgCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                ClipToBounds="True">
            <StackPanel>
                <!-- Cabecera tabla -->
                <Border Padding="20,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E1E3C" Offset="0"/>
                            <GradientStop Color="#16163A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Empleado" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="Correo" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="Rol" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Teléfono" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="4" Text="RFC" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="5" Text="Acciones" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Filas -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <StackPanel>

                        <!-- Empleado 1: Admin -->
                        <Border Padding="20,14" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <!-- Nombre + avatar -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F26419" Offset="0"/>
                                                <GradientStop Color="#D94F00" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Admin User" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="ID: 001" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="admin@byle.com" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1AF26419" CornerRadius="7"
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Administrador" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F26419"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="667-123-4567" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="GUMA901212AB3" FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Editar empleado" Margin="0,0,4,0">
                                        <fa:IconImage Icon="PenToSquare" Width="15" Height="15"
                                                      Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Eliminar empleado">
                                        <fa:IconImage Icon="Trash" Width="15" Height="15" Foreground="#F87171"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empleado 2: Josué -->
                        <Border Padding="20,14" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0"
                                            Background="#1A34D399">
                                        <TextBlock Text="J" FontSize="14" FontWeight="Bold" Foreground="#34D399"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Josué Vega" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="ID: 002" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="josue@byle.com" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1AB0B0D0" CornerRadius="7"
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Recepcionista" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="667-987-6543" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="VEGJ950318XY0" FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Editar empleado" Margin="0,0,4,0">
                                        <fa:IconImage Icon="PenToSquare" Width="15" Height="15"
                                                      Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Eliminar empleado">
                                        <fa:IconImage Icon="Trash" Width="15" Height="15" Foreground="#F87171"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empleado 3: Camila -->
                        <Border Padding="20,14" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushBgCardHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0"
                                            Background="#1AFBBF24">
                                        <TextBlock Text="C" FontSize="14" FontWeight="Bold" Foreground="#FBBF24"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Camila Macías" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock Text="ID: 003" FontSize="11"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="camila@byle.com" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1AB0B0D0" CornerRadius="7"
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Recepcionista" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="667-555-1234" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="MAHC030101AB0" FontSize="11"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Editar empleado" Margin="0,0,4,0">
                                        <fa:IconImage Icon="PenToSquare" Width="15" Height="15"
                                                      Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Button>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Eliminar empleado">
                                        <fa:IconImage Icon="Trash" Width="15" Height="15" Foreground="#F87171"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: total de empleados -->
                <Border Padding="20,10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E1E3C" Offset="0"/>
                            <GradientStop Color="#16163A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                        <Run Text="3"/>
                        <Run Text=" empleados registrados en el sistema"/>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
