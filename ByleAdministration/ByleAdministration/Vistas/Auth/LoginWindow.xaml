<Window x:Class="ByleAdministration.Vistas.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="Byle Administration"
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0D0D1B">

    <Window.Resources>
        <!-- Gradiente de fondo de la ventana -->
        <LinearGradientBrush x:Key="LoginWindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0D1B" Offset="0"/>
            <GradientStop Color="#101024" Offset="0.6"/>
            <GradientStop Color="#130F22" Offset="1"/>
        </LinearGradientBrush>

        <!--
            Estilos de campos definidos aquí (self-contained) para garantizar
            que el StaticResource esté disponible al parsear este archivo,
            independientemente del orden de carga de App.xaml.
        -->

        <!-- Contenedor border con icono + campo -->
        <Style x:Key="LoginFieldContainer" TargetType="Border">
            <Setter Property="Background"      Value="#1A1A32"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="#2A2A4A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="50"/>
        </Style>

        <!-- TextBox transparente dentro del contenedor -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="#F4F4FA"/>
            <Setter Property="FontSize"          Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CaretBrush"        Value="#F26419"/>
            <Setter Property="SelectionBrush"    Value="#F26419"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox transparente dentro del contenedor -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="#F4F4FA"/>
            <Setter Property="FontSize"          Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SelectionBrush"    Value="#F26419"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--
    ══════════════════════════════════════════════════════
      LOGIN WINDOW
      • Logo Byle (escudo + mancuerna + texto)
      • Solo bienvenida y formulario — sin info del programa
      • WindowStyle=None → arrastre vía LogoBar
      • Accesibilidad: contraste alto, labels sobre campos,
        focus indicator naranja, font size legible
    ══════════════════════════════════════════════════════
    -->

    <Grid Background="{StaticResource LoginWindowBg}">

        <!-- Botón cerrar — esquina superior derecha -->
        <Button x:Name="BtnCerrarLogin"
                Width="28" Height="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Background="#20FFFFFF"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnCerrarLogin_Click"
                ToolTip="Cerrar">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseBg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6" Width="28" Height="28">
                        <fa:IconImage Icon="Xmark" Width="11" Height="11"
                                      Foreground="#B0B0D0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseBg" Property="Background" Value="#F87171"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Tarjeta de login centrada -->
        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="380"
                CornerRadius="16"
                BorderBrush="#2A2A4A"
                BorderThickness="1"
                Padding="40,36,40,32">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#14142C" Offset="0"/>
                    <GradientStop Color="#0F0F22" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40"
                                  ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <StackPanel>

                <!-- ── ZONA DE LOGO (también sirve de barra de arrastre) ── -->
                <StackPanel x:Name="LogoBar"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="LogoBar_MouseLeftButtonDown">

                    <!-- Icono de escudo con mancuerna encima -->
                    <Grid Width="60" Height="60"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10">
                        <fa:IconImage Icon="Shield"
                                      Width="60" Height="60"
                                      Foreground="#F26419"/>
                        <fa:IconImage Icon="Dumbbell"
                                      Width="22" Height="22"
                                      Foreground="White"
                                      Opacity="0.95"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,0"/>
                    </Grid>

                    <!-- Nombre de marca -->
                    <TextBlock Text="BYLE"
                               FontSize="30"
                               FontWeight="Black"
                               Foreground="#F26419"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>

                    <!-- Subtítulo de bienvenida (SIN información del programa) -->
                    <TextBlock Text="Bienvenido de vuelta"
                               FontSize="13"
                               Foreground="#B0B0D0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ── SEPARADOR ── -->
                <Rectangle Height="1" Margin="0,0,0,24">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#2A2A4A"     Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ── CAMPO CORREO ── -->
                <TextBlock Text="Correo electrónico"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#B0B0D0"
                           Margin="2,0,0,6"/>

                <!-- Contenedor con icono + TextBox -->
                <Border x:Name="CorreoBorder"
                        Style="{StaticResource LoginFieldContainer}"
                        Margin="0,0,0,16"
                        GotFocus="InputContainer_GotFocus"
                        LostFocus="InputContainer_LostFocus">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconImage Grid.Column="0"
                                      Icon="Envelope"
                                      Width="15" Height="15"
                                      Foreground="#787898"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="TxtCorreo"
                                 Style="{StaticResource LoginTextBox}"
                                 AutomationProperties.Name="Correo electrónico"/>
                    </Grid>
                </Border>

                <!-- ── CAMPO CONTRASEÑA ── -->
                <TextBlock Text="Contraseña"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#B0B0D0"
                           Margin="2,0,0,6"/>

                <Border x:Name="ContrasenaBorder"
                        Style="{StaticResource LoginFieldContainer}"
                        Margin="0,0,0,28"
                        GotFocus="InputContainer_GotFocus"
                        LostFocus="InputContainer_LostFocus">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconImage Grid.Column="0"
                                      Icon="Lock"
                                      Width="15" Height="15"
                                      Foreground="#787898"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1"
                                     x:Name="PbxContrasena"
                                     Style="{StaticResource LoginPasswordBox}"
                                     AutomationProperties.Name="Contraseña"/>
                    </Grid>
                </Border>

                <!-- ── BOTÓN INICIAR SESIÓN ── -->
                <Button x:Name="BtnIngresar"
                        Style="{StaticResource BtnPrimario}"
                        Height="48"
                        FontSize="14"
                        FontWeight="Bold"
                        Margin="0,0,0,16"
                        Click="BtnIngresar_Click"
                        AutomationProperties.Name="Iniciar sesión">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="RightToBracket"
                                      Width="15" Height="15"
                                      Foreground="White"
                                      Margin="0,0,8,0"/>
                        <TextBlock Text="INICIAR SESIÓN"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- ── LINK A REGISTRO ── -->
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#787898">
                    <Hyperlink x:Name="LnkRegistro"
                               Click="LnkRegistro_Click"
                               Foreground="#B0B0D0"
                               TextDecorations="None">
                        <TextBlock Text="Registrar nuevo empleado"/>
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>
