<UserControl x:Class="ByleAdministration.Vistas.Clientes.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="{DynamicResource BrushBgPrimary}">

    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ COLUMNA IZQUIERDA — lista ══════════ -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <!-- ── Encabezado + acciones ────────────────────────── -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Clientes"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock x:Name="TxtContador" Text="Cargando..."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource BtnPrimario}"
                            Click="BtnNuevoCliente_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="UserPlus" Width="13" Height="13"
                                          Foreground="White" Margin="0,0,7,0"/>
                            <TextBlock Text="Nuevo cliente" FontSize="12.5"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Barra de búsqueda -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <fa:IconImage Grid.Column="0" Icon="MagnifyingGlass"
                                      Width="13" Height="13"
                                      Foreground="{DynamicResource BrushTextMuted}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtBuscar" Grid.Column="1"
                                 Height="42" BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushAccent}"
                                 FontSize="12.5" VerticalContentAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>
                        <Button Grid.Column="2" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Margin="0,0,4,0"
                                Click="BtnLimpiarBusqueda_Click">
                            <fa:IconImage Icon="Xmark" Width="10" Height="10"
                                          Foreground="{DynamicResource BrushTextMuted}"/>
                        </Button>
                        <!-- Separador vertical -->
                        <Rectangle Grid.Column="3" Width="1" Height="18"
                                   Fill="{DynamicResource BrushBorder}"
                                   VerticalAlignment="Center"/>
                        <!-- Filtros pill -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="6,0,6,0">
                            <RadioButton x:Name="RbTodos" GroupName="Filtro"
                                         IsChecked="True"
                                         Content="Todos" FontSize="11.5"
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         Checked="RbFiltro_Checked"
                                         Style="{StaticResource {x:Type RadioButton}}"
                                         Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbActivos" GroupName="Filtro"
                                         Content="Activos" FontSize="11.5"
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         Checked="RbFiltro_Checked"
                                         Style="{StaticResource {x:Type RadioButton}}"
                                         Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbInactivos" GroupName="Filtro"
                                         Content="Inactivos" FontSize="11.5"
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         Checked="RbFiltro_Checked"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Encabezado tabla ──────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8,8,0,0" Padding="12,9,12,9"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CLIENTE" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="TELÉFONO" FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="MEMBRESÍA" FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="ESTADO" FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Lista dinámica ────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelClientes"/>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- ══════════ COLUMNA DERECHA — perfil ══════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource BrushBgCard}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="0,0,0,0"
                    ClipToBounds="True">
                <StackPanel>

                    <!-- ── Banda superior con avatar ─────────────── -->
                    <Border Height="72" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1AF26419" Offset="0"/>
                                <GradientStop Color="#08F26419" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Avatar (sobresale de la banda) -->
                    <Border Width="64" Height="64" CornerRadius="32"
                            HorizontalAlignment="Center"
                            Margin="0,-32,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F26419" Offset="0"/>
                                <GradientStop Color="#D94F00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#F26419" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtInicialesPerfil" Text="--"
                                   FontSize="22" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Nombre + badge estado -->
                    <StackPanel HorizontalAlignment="Center" Margin="16,10,16,0">
                        <TextBlock x:Name="TxtNombrePerfil"
                                   Text="Selecciona un cliente"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <Border x:Name="BorderEstadoPerfil"
                                Background="#1A3D2B" CornerRadius="20" Padding="12,4"
                                HorizontalAlignment="Center" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#2ECC71"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtEstadoPerfil"
                                           Text="Sin selección"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="#2ECC71"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Separador -->
                    <Rectangle Height="1" Margin="16,14,16,0"
                               Fill="{DynamicResource BrushBorder}"/>

                    <!-- ── Datos del cliente ─────────────────────── -->
                    <StackPanel Margin="18,12,18,0">

                        <!-- Correo -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="CORREO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Envelope" Width="12" Height="12"
                                              Foreground="{DynamicResource BrushTextMuted}"
                                              Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtCorreoPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Teléfono -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="TELÉFONO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Phone" Width="12" Height="12"
                                              Foreground="{DynamicResource BrushTextMuted}"
                                              Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtTelefonoPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Membresía -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="MEMBRESÍA" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="IdCard" Width="12" Height="12"
                                              Foreground="{DynamicResource BrushAccent}"
                                              Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtMembresiaPerfil" Text="—"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Separador sutil -->
                        <Rectangle Height="1" Fill="{DynamicResource BrushBorder}"
                                   Margin="0,2,0,12"/>

                        <!-- Grid de datos secundarios -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Edad -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="EDAD" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtEdadPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!-- Ciudad -->
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="CIUDAD" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtCiudadPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!-- Inscripción -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="INSCRIPCIÓN" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtInscripcionPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!-- Renovación -->
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="RENOVACIÓN" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,3"/>
                                <TextBlock x:Name="TxtRenovacionPerfil" Text="—"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!-- Huella -->
                            <StackPanel Grid.Row="4" Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                <TextBlock Text="HUELLA DIGITAL" FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage x:Name="IconHuellaPerfil"
                                                  Icon="Fingerprint" Width="12" Height="12"
                                                  Foreground="{DynamicResource BrushTextMuted}"
                                                  Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtHuellaPerfil"
                                               Text="—"
                                               FontSize="12"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ── Botón Editar ────────────────────────────── -->
                    <Border Padding="18,14,18,18" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnSecundario}"
                                HorizontalAlignment="Stretch"
                                Height="40" FontSize="12.5"
                                Click="BtnEditarCliente_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="PenToSquare" Width="13" Height="13"
                                              Foreground="{DynamicResource BrushAccent}"
                                              Margin="0,0,8,0"/>
                                <TextBlock Text="Editar cliente"
                                           Foreground="{DynamicResource BrushAccent}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
